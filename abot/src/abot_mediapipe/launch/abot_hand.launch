<launch>
  <arg name="input_image" default="/usb_cam/image_raw"/>
	<include file="$(find yolov8_ros)/launch/usb_cam.launch"/>
  <node name="abot_hand" pkg="abot_mediapipe" type="hand.py" output="screen" >
      <param name="camera_topic" value="$(arg input_image)" type="string" />
  </node>
</launch>
