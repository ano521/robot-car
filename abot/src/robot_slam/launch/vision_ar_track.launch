<launch>
    <arg name="start_camera" default="false"/>
    <arg name="camera_device" default="/dev/video0"/>
    <arg name="camera_image_topic" default="/usb_cam/image_raw"/>
    <arg name="camera_info_topic" default="/usb_cam/camera_info"/>
    <arg name="pixel_format" default="yuyv"/>
    <arg name="framerate" default="30"/>
    <arg name="marker_size" default="4.4"/>
    <arg name="target_marker_id" default="-1"/>

    <arg name="enable_motion" default="false"/>
    <arg name="deadband" default="0.06"/>
    <arg name="angular_gain" default="0.8"/>
    <arg name="max_angular_speed" default="0.35"/>
    <arg name="lost_timeout" default="0.6"/>
    <arg name="horizontal_fov_degrees" default="62.0"/>
    <arg name="use_camera_info_fov" default="true"/>

    <include file="$(find robot_slam)/launch/vision_recognition.launch">
        <arg name="start_camera" value="$(arg start_camera)"/>
        <arg name="camera_device" value="$(arg camera_device)"/>
        <arg name="camera_image_topic" value="$(arg camera_image_topic)"/>
        <arg name="camera_info_topic" value="$(arg camera_info_topic)"/>
        <arg name="pixel_format" value="$(arg pixel_format)"/>
        <arg name="framerate" value="$(arg framerate)"/>
        <arg name="enable_template" value="false"/>
        <arg name="enable_ar" value="true"/>
        <arg name="marker_size" value="$(arg marker_size)"/>
        <arg name="target_marker_id" value="$(arg target_marker_id)"/>
    </include>

    <node name="vision_tracker"
          pkg="robot_slam"
          type="vision_tracker.py"
          output="screen">
        <param name="source" value="ar"/>
        <param name="ar_topic" value="/ar_pose_marker"/>
        <param name="camera_info_topic" value="$(arg camera_info_topic)"/>
        <param name="target_marker_id" value="$(arg target_marker_id)"/>
        <param name="horizontal_fov_degrees" value="$(arg horizontal_fov_degrees)"/>
        <param name="use_camera_info_fov" value="$(arg use_camera_info_fov)"/>
        <param name="enable_motion" value="$(arg enable_motion)"/>
        <param name="deadband" value="$(arg deadband)"/>
        <param name="angular_gain" value="$(arg angular_gain)"/>
        <param name="max_angular_speed" value="$(arg max_angular_speed)"/>
        <param name="lost_timeout" value="$(arg lost_timeout)"/>
    </node>
</launch>
