<launch>
    <arg name="gui" default="true"/>
    <arg name="image_topic" default="/usb_cam/image_raw"/>
    <arg name="objects_path" default="$(find find_object_2d)/object"/>
    <arg name="settings_path" default="$(find find_object_2d)/../../runtime/find_object_2d.ini"/>
    <arg name="start_camera" default="true"/>
    <arg name="camera_device" default="/dev/video0"/>
    <arg name="pixel_format" default="yuyv"/>
    <arg name="framerate" default="30"/>

	<!-- Nodes -->
	<node name="find_object_2d" pkg="find_object_2d" type="find_object_2d">
		<remap from="image" to="$(arg image_topic)"/>
		<param name="gui" value="$(arg gui)" type="bool"/>
		<param name="objects_path" value="$(arg objects_path)" type="str"/>
		<param name="settings_path" value="$(arg settings_path)" type="str"/>
	</node>

	<node name="print_objects_detected" pkg="find_object_2d" type="print_objects_detected" output="screen">
		<remap from="image" to="$(arg image_topic)"/>
	</node>

	<group if="$(arg start_camera)">
		<include file="$(find cam_track)/launch/usb_cam_with_calibration.launch">
			<arg name="video_device" value="$(arg camera_device)"/>
			<arg name="pixel_format" value="$(arg pixel_format)"/>
			<arg name="framerate" value="$(arg framerate)"/>
		</include>
	</group>

	
</launch>
